function Library:StopFeatures()
    Farm.Enabled = false
    Farm.TeleportFarmEnabled = false
    Farm.TeleportRejectedUntil = 0
    Farm.AutoPlaceEnabled = false
    Farm.AutoHatchBestEnabled = false
    Farm.AutomationBusy = false
    clearPlatform()

    local root = getRoot()
    if root then
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

function Library:Unload()
    if self._unloading then
        return
    end

    self._unloading = true
    Farm.Alive = false
    self:StopFeatures()

    for _, connection in ipairs(Farm.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    Farm.Connections = {}

    local floaters = {}
    for _, floater in ipairs(self.Floaters or {}) do
        table.insert(floaters, floater)
    end
    for _, floater in ipairs(floaters) do
        pcall(function()
            floater:Destroy()
        end)
    end

    local windows = {}
    for _, window in ipairs(self.Windows or {}) do
        table.insert(windows, window)
    end
    for _, window in ipairs(windows) do
        pcall(function()
            if window.Gui and window.Gui.Parent then
                window:Destroy()
            end
        end)
    end

    if notifyGui then
        pcall(function()
            notifyGui:Destroy()
        end)
        notifyGui = nil
        notifyHolder = nil
    end

    runtimeAlive = false

    local environment = (getgenv and getgenv()) or _G
    if environment.__CrystalHubUnload == self._runtimeUnloadHandle then
        environment.__CrystalHubUnload = nil
    end

    self._unloading = false
end

Library._runtimeUnloadHandle = function()
    pcall(function()
        Library:Unload()
    end)
end

((getgenv and getgenv()) or _G).__CrystalHubUnload = Library._runtimeUnloadHandle

