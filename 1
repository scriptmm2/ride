local function normalizeEggName(name)
    name = tostring(name or "")

    local direct = Farm.EggAliases[name]
    if direct then
        return direct
    end

    local compact = string.lower((name:gsub("%s+", "")))

    for alias, canonical in pairs(Farm.EggAliases) do
        if string.lower((alias:gsub("%s+", ""))) == compact then
            return canonical
        end
    end

    for knownName in pairs(Farm.EggValues) do
        if string.lower((knownName:gsub("%s+", ""))) == compact then
            return knownName
        end
    end

    return name
end

local function parseCompactGameNumber(value)
    local s = tostring(value or "")
    s = s:gsub(",", ""):gsub("%s+", "")

    local numberText, suffix = s:match("([%d%.]+)([%a]*)")
    local number = tonumber(numberText)
    if not number then
        return nil
    end

    suffix = string.upper(suffix or "")

    local multipliers = {
        [""] = 1,
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12,
        QA = 1e15,
        QI = 1e18,
        SX = 1e21,
        SP = 1e24,
        OC = 1e27,
        NO = 1e30,
        DC = 1e33,
    }

    local multiplier = multipliers[suffix]
    if not multiplier then
        return nil
    end

    return number * multiplier
end

local function discoverEggValueFromGame(canonicalName)
    canonicalName = normalizeEggName(canonicalName)

    -- First try ReplicatedStorage.GameData.Eggs. Different updates have used
    -- slightly different field names, so inspect a few likely numeric fields.
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    local eggsModule = gameData and gameData:FindFirstChild("Eggs")

    if eggsModule and eggsModule:IsA("ModuleScript") then
        local ok, data = pcall(require, eggsModule)

        if ok and type(data) == "table" then
            local aliases = {canonicalName}

            for alias, canonical in pairs(Farm.EggAliases) do
                if canonical == canonicalName then
                    table.insert(aliases, alias)
                end
            end

            for _, alias in ipairs(aliases) do
                local entry = data[alias]

                if type(entry) == "table" then
                    for _, field in ipairs({
                        "Luck",
                        "Value",
                        "SampleSize",
                        "Price",
                        "Cost",
                        "RarityValue",
                    }) do
                        local value = tonumber(entry[field])
                        if value and value > 0 then
                            return value
                        end
                    end
                elseif tonumber(entry) then
                    local value = tonumber(entry)
                    if value and value > 0 then
                        return value
                    end
                end
            end
        end
    end

    -- Fallback: the game's egg menu has historically shown labels such as
    -- "Crystal Egg  [150.0K]". Read the live UI instead of hardcoding a guess.
    local aliasesLower = {}
    aliasesLower[string.lower(canonicalName)] = true

    for alias, canonical in pairs(Farm.EggAliases) do
        if canonical == canonicalName then
            aliasesLower[string.lower(alias)] = true
        end
    end

    for _, obj in ipairs(PlayerGui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local raw = tostring(obj.Text or "")
            local lower = string.lower(raw)

            local matched = false
            for aliasLower in pairs(aliasesLower) do
                if string.find(lower, aliasLower, 1, true) then
                    matched = true
                    break
                end
            end

            if matched then
                local bracket = raw:match("%[([^%]]+)%]")
                if bracket then
                    local parsed = parseCompactGameNumber(bracket)
                    if parsed and parsed > 0 then
                        return parsed
                    end
                end

                local afterName = raw:match("[Ee]gg%s+([%d%.,]+%s*[%a]*)")
                if afterName then
                    local parsed = parseCompactGameNumber(afterName)
                    if parsed and parsed > 0 then
                        return parsed
                    end
                end
            end
        end
    end

    return nil
end

local function refreshDynamicEggValue(canonicalName)
    canonicalName = normalizeEggName(canonicalName)

    local current = tonumber(Farm.EggValues[canonicalName]) or 0
    if current > 0 then
        return current
    end

    local cached = tonumber(Farm.DynamicEggValues[canonicalName]) or 0
    if cached > 0 then
        return cached
    end

    local discovered = discoverEggValueFromGame(canonicalName)
    if discovered and discovered > 0 then
        Farm.DynamicEggValues[canonicalName] = discovered
        Farm.EggValues[canonicalName] = discovered
        return discovered
    end

    return 0
end

