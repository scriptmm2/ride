local function mapSubTabName(parentName, subName)
    -- Preserve the original source organization while using Crystal sections
    -- instead of creating a separate sidebar tab for every source sub-tab.
    if parentName == "Auto Farm" then
        return "Auto Farm", tostring(subName)
    elseif parentName == "Shops" then
        return "Shops", tostring(subName)
    elseif parentName == "ESP" then
        return "ESP", tostring(subName)
    elseif parentName == "Settings" then
        return "Settings", tostring(subName)
    end

    return tostring(parentName), tostring(subName)
end

function AdapterTab:AddSubTab(name)
    local actualTabName, sectionName = mapSubTabName(self.Name, tostring(name))

    local actualTab = self.CreatedTabs[actualTabName]
    if not actualTab then
        actualTab = self.Window.Raw:AddTab(actualTabName)
        self.CreatedTabs[actualTabName] = actualTab
    end

    -- Keep the egg-name selector at the top of Auto Farm, before its controls.
    if self.Name == "Auto Farm" and tostring(name) == "Eggs" then
        local filterSection = actualTab:AddSection("Egg Selection")
        filterSection:AddMultiDropdown(
            "Eggs to Farm (value, empty = all)",
            getCrystalEggTypeOptions(),
            {},
            function(selected)
                CrystalEggTypeSelection = {}
                for _, display in ipairs(selected or {}) do
                    local eggName = CrystalEggTypeDisplayToName[display] or display
                    CrystalEggTypeSelection[crystalCanonicalEggName(eggName)] = true
                end
            end,
            "crystal_egg_types"
        )
    end

    local rawSection = actualTab:AddSection(sectionName)

    local wrapped = setmetatable({
        Raw = rawSection,
        ParentName = self.Name,
        Name = tostring(name),
    }, AdapterSection)

    return wrapped
end

