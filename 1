function AdapterSection:AddParagraph(config)
    config = config or {}
    local title = tostring(config.Title or "")
    local body = tostring(config.Text or "")
    local prefix = title ~= "" and (title .. "\n") or ""
    local label = self.Raw:AddLabel(prefix .. body)

    return {
        Set = function(_, newText)
            label:Set(prefix .. tostring(newText or ""))
        end,
    }
end

function AdapterSection:AddButton(config)
    config = config or {}
    local name = tostring(config.Name or "Button")

    if HiddenControls[name] then
        return dummyControl(false)
    end

    return self.Raw:AddButton(
        name == "Unload Arc HUB" and "Unload Crystal Hub" or name,
        config.Callback or function() end,
        config.Flag
    )
end

function AdapterSection:AddToggle(config)
    config = config or {}
    local name = tostring(config.Name or "Toggle")

    if HiddenControls[name] then
        -- The source state already contains the intended default value.
        return dummyControl(config.Default == true)
    end

    return self.Raw:AddToggle(
        name,
        config.Default == true,
        config.Callback or function() end,
        config.Flag
    )
end

function AdapterSection:AddSlider(config)
    config = config or {}
    local name = tostring(config.Name or "Slider")

    if HiddenControls[name] then
        return dummyControl(config.Default)
    end

    local minValue = tonumber(config.Min) or 0
    local maxValue = tonumber(config.Max) or 100
    local defaultValue = tonumber(config.Default) or minValue

    local step = tonumber(config.Step)
    if not step then
        local integral =
            minValue == math.floor(minValue)
            and maxValue == math.floor(maxValue)
            and defaultValue == math.floor(defaultValue)
        step = integral and 1 or 0.1
    end

    return self.Raw:AddSlider(
        name,
        minValue,
        maxValue,
        defaultValue,
        config.Callback or function() end,
        step,
        config.Flag
    )
end

function AdapterSection:AddDropdown(config)
    config = config or {}

    return self.Raw:AddDropdown(
        tostring(config.Name or "Dropdown"),
        config.Options or {},
        config.Default,
        config.Callback or function() end,
        config.Flag
    )
end

function AdapterSection:AddMultiDropdown(config)
    config = config or {}

    return self.Raw:AddMultiDropdown(
        tostring(config.Name or "Multi Dropdown"),
        config.Options or {},
        config.Default or {},
        config.Callback or function() end,
        config.Flag
    )
end

function AdapterWindow:Destroy()
    if AdapterLibrary._floatingButton then
        pcall(function()
            AdapterLibrary._floatingButton:Destroy()
        end)
        AdapterLibrary._floatingButton = nil
    end

    if self.Raw then
        pcall(function()
            self.Raw:Destroy()
        end)
    end
end

