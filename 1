                        -- refresh active pets immediately after this hatch.
                        if Farm.AutoHatchBestEnabled then
                            task.wait(math.max(Farm.Config.HatchDelay, 1.15))
                            local bestOk, bestMessage = pressPlaceBest()
                            if bestOk then
                                setFarmStatus(message .. "; " .. bestMessage)
                            end
                        end

                        task.wait(0.35)
                    elseif not ok then
                        Farm.LastError = tostring(success)
                        warn("[CrystalHub] Plot hatch error: " .. tostring(success))
                    end
                else
                    setFarmStatus(string.format(
                        "Plot full %d/%d - waiting for an egg to mature",
                        count,
                        Farm.Config.MaxPlotEggs
                    ))
                    task.wait(0.8)
                end
            else
                local ok, success, message = pcall(placeOneEgg)

                if ok and success then
                    setFarmStatus(string.format(
                        "%s | Plot %d/%d",
                        tostring(message),
                        getPlotEggCount(plot),
                        Farm.Config.MaxPlotEggs
                    ))
                    task.wait(Farm.Config.PlaceDelay)
                elseif not ok then
                    Farm.LastError = tostring(success)
                    warn("[CrystalHub] Auto Place error: " .. tostring(success))
                end
            end

            Farm.AutomationBusy = false
            task.wait(Farm.Config.RanchLoopDelay)
        else
            task.wait(0.2)
        end
    end
end)

local function selectedCount()
    local count = 0
    for _, enabled in pairs(Farm.Selected) do
        if enabled then
            count = count + 1
        end
    end
    return count
end

local function spawnedCount()
    local folder = Farm.RenderedEggs
    if not folder or not folder.Parent then
        folder = refreshRenderedEggs()
    end
    if not folder then
        return 0
    end

    local count = 0
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            count = count + 1
        end
    end
    return count
end

local function getBestTarget()
    local folder = Farm.RenderedEggs
    if not folder or not folder.Parent then
        folder = refreshRenderedEggs()
    end
    if not folder then
        return nil
    end

    local bestTarget = nil
    local bestValue = -1

    for _, child in ipairs(folder:GetChildren()) do
        local canonicalName = normalizeEggName(child.Name)

        if (child:IsA("Model") or child:IsA("BasePart"))
            and Farm.Selected[canonicalName] then
            local value = getEggValue(child)
            if value > bestValue then
                bestValue = value
                bestTarget = child
            end
        end
    end

    return bestTarget
end

local function setAutoFarm(enabled)
    Farm.Enabled = enabled and true or false

    if Farm.Enabled then
        if selectedCount() == 0 then
            setFarmStatus("Select at least one egg")
        else
            setFarmStatus("Auto Farm enabled")
        end
    else
        setFarmStatus("Stopped")
        clearPlatform()

        local root = getRoot()
        if root then
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function buildSpawnedSummary()
    local folder = Farm.RenderedEggs
    if not folder or not folder.Parent then
        folder = refreshRenderedEggs()
    end

    if not folder then
        return "RenderedEggs folder not found."
    end

    local entries = {}
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") or child:IsA("BasePart") then
            table.insert(entries, {
                Object = child,
                Name = child.Name,
                Value = getEggValue(child),
                Distance = distanceTo(child),
            })
        end
    end

    table.sort(entries, function(a, b)
        if a.Value == b.Value then
            return a.Distance < b.Distance
        end
        return a.Value > b.Value
    end)

    if #entries == 0 then
        return "No spawned eggs detected."
    end

    local lines = {}
    local limit = math.min(#entries, 18)

    for index = 1, limit do
        local entry = entries[index]
        local distanceText = entry.Distance == math.huge
            and "-- m"
            or string.format("%d m", math.floor(entry.Distance + 0.5))
        table.insert(
            lines,
            string.format("%s  ·  %s  ·  %s", entry.Name, formatNumber(entry.Value), distanceText)
        )
    end

    if #entries > limit then
        table.insert(lines, string.format("...and %d more", #entries - limit))
    end

    return table.concat(lines, "\n")
end

