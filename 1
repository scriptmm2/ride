-- Render the loader for a frame before the hidden interface is constructed.
if crystalLoader then task.wait() end

-- Compile and execute on the injector's original thread. The main window and
-- floating button stay hidden until the loader has fully disappeared.
local CrystalRideChunk, CrystalRideCompileError = loadstring(
    "local Library = _G.__CrystalRideCompatLibrary\n" .. CrystalRideSource
)

if not CrystalRideChunk then
    warn("[CrystalHub] Ride a Pet source compile error: " .. tostring(CrystalRideCompileError))
    CrystalUILibrary:Notify({
        Title = "Crystal Hub",
        Text = "Ride a Pet source compile error: " .. tostring(CrystalRideCompileError),
        Duration = 8,
        Kind = "error",
    })
    if crystalLoader then pcall(function() crystalLoader.Gui:Destroy() end) end
else
    if crystalLoader then pcall(function() crystalLoader:Set(0.65, "Building interface") end) end
    local ok, result = pcall(CrystalRideChunk)
    if not ok then
        warn("[CrystalHub] Ride a Pet source runtime error: " .. tostring(result))
        CrystalUILibrary:Notify({
            Title = "Crystal Hub",
            Text = "Ride a Pet source runtime error: " .. tostring(result),
            Duration = 8,
            Kind = "error",
        })
        if crystalLoader then pcall(function() crystalLoader.Gui:Destroy() end) end
    else
        local hub = result

        CrystalEnvironment.__CrystalHubUnload = function()
            if hub and type(hub.Unload) == "function" then
                pcall(hub.Unload)
            end

            if AdapterLibrary._floatingButton then
                pcall(function()
                    AdapterLibrary._floatingButton:Destroy()
                end)
                AdapterLibrary._floatingButton = nil
            end

            pcall(function()
                if notifyGui and notifyGui.Parent then
                    notifyGui:Destroy()
                end
            end)

            runtimeAlive = false
            CrystalEnvironment.__CrystalHubUnload = nil
            _G.__CrystalEggTypeAllowed = nil
            CrystalEnvironment.__CrystalRideCompatLibrary = nil
            _G.__CrystalRideCompatLibrary = nil
        end

        if crystalLoader then
            pcall(function() crystalLoader:Set(0.9, "Ready") end)
            local remaining = 1.5 - (time() - loaderStartedAt)
            if remaining > 0 then task.wait(remaining) end
            pcall(function() crystalLoader:Finish() end)
            local deadline = time() + 2
            while crystalLoader.Gui and crystalLoader.Gui.Parent and time() < deadline do
                task.wait(0.05)
            end
            if crystalLoader.Gui and crystalLoader.Gui.Parent then
                pcall(function() crystalLoader.Gui:Destroy() end)
            end
        end
        if AdapterLibrary._rawWindow and AdapterLibrary._rawWindow.Gui then
            AdapterLibrary._rawWindow.LoadingLocked = false
            AdapterLibrary._rawWindow.Gui.Enabled = true
        end
        if AdapterLibrary._floatingButton then
            AdapterLibrary._floatingButton:SetVisible(true)
        end
        print("[CrystalHub] Ride a Pet exact-source v12 UI loaded")
    end
end
