local function getEggValue(target)
    if not target then
        return 0
    end

    local rawName = type(target) == "string" and target or target.Name
    local name = normalizeEggName(rawName)

    local value = tonumber(Farm.EggValues[name]) or 0

    if value <= 0 then
        value = refreshDynamicEggValue(name)
    end

    -- If the update does not expose its luck value to the client yet, still
    -- prioritize the explicitly supported new egg instead of ignoring it.
    if value <= 0 and name == "Volcano Egg" then
        return 1e30
    end

    return value
end

local function getTargetCFrame(target)
    if not target or not target.Parent then
        return nil
    end

    if target:IsA("Model") then
        local ok, pivot = pcall(function()
            return target:GetPivot()
        end)
        return ok and pivot or nil
    elseif target:IsA("BasePart") then
        return target.CFrame
    end

    return nil
end

local function distanceTo(target)
    local root = getRoot()
    local targetCFrame = getTargetCFrame(target)
    if not root or not targetCFrame then
        return math.huge
