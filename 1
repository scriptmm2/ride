            task.wait(0.25)
        end
    end
end)

task.spawn(function()
    while Farm.Alive do
        if Farm.AutoPlaceEnabled and not Farm.AutomationBusy then
            Farm.AutomationBusy = true

            local plot = getOwnedPlot()
            local count = getPlotEggCount(plot)

