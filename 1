local function readPetSpeed(obj)
    if not obj then
        return 0
    end

    local data = obj:FindFirstChild("Data")
    local speed = data and data:FindFirstChild("Speed")

    if speed and speed:IsA("ValueBase") then
        return tonumber(speed.Value) or 0
    end

    local attr = obj:GetAttribute("Speed")
    return tonumber(attr) or 0
end

local function readPetWeight(obj)
    if not obj then
        return 0
    end

    local attr = obj:GetAttribute("Weight")
    if tonumber(attr) then
        return tonumber(attr)
    end

    local data = obj:FindFirstChild("Data")
    local weight = data and data:FindFirstChild("Weight")

    if weight and weight:IsA("ValueBase") then
        return tonumber(weight.Value) or 0
    end

    return 0
end

local function getPetCapacity()
    local main = PlayerGui:FindFirstChild("Main")
    local tracker = main and main:FindFirstChild("PetsTracker")
    local header = tracker and tracker:FindFirstChild("Header")
    local label = header and header:FindFirstChild("Capacity")

    if label and label:IsA("TextLabel") then
        local current, maximum = string.match(label.Text or "", "(%d+)%s*/%s*(%d+)")
        maximum = tonumber(maximum)

        if maximum and maximum > 0 then
            return maximum
        end
    end

    local plot = getOwnedPlot()
    local pets = plot and plot:FindFirstChild("Pets")
    local currentCount = pets and #pets:GetChildren() or 0

    return math.max(currentCount, 1)
end

local function petKeyOf(obj)
    if not obj then
        return nil
    end

    local key = obj:GetAttribute("PetKey")
    if key ~= nil and tostring(key) ~= "" then
        return tostring(key)
    end

    return nil
end

local function gatherAllOwnedPets(plot, rememberedSpeed)
    local all = {}
    local byKey = {}
    local placed = {}

    rememberedSpeed = rememberedSpeed or {}

    local function add(obj, isPlaced)
        local key = petKeyOf(obj)
        if not key or byKey[key] then
            return
        end

        local liveSpeed = readPetSpeed(obj)
        local record = {
            Key = key,
            Object = obj,
            Speed = math.max(liveSpeed, tonumber(rememberedSpeed[key]) or 0),
            Weight = readPetWeight(obj),
            Placed = isPlaced == true,
            Position = isPlaced and getPetWorldPosition(obj) or nil,
        }

        byKey[key] = record
        table.insert(all, record)

        if record.Placed then
            table.insert(placed, record)
        end
    end

    local petsFolder = plot and plot:FindFirstChild("Pets")
    if petsFolder then
        for _, pet in ipairs(petsFolder:GetChildren()) do
            add(pet, true)
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and petKeyOf(tool) then
                add(tool, false)
            end
        end
    end

    local character = getCharacter()
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and petKeyOf(tool) then
                add(tool, false)
            end
        end
    end

    table.sort(all, function(a, b)
        if a.Speed == b.Speed then
            if a.Weight == b.Weight then
                return a.Key < b.Key
            end
            return a.Weight > b.Weight
        end
        return a.Speed > b.Speed
    end)

    return all, placed
end

local function findPlacedPetByKey(plot, key)
    local pets = plot and plot:FindFirstChild("Pets")
    if not pets or not key then
        return nil
    end

    for _, pet in ipairs(pets:GetChildren()) do
        if tostring(petKeyOf(pet) or "") == tostring(key) then
            return pet
        end
    end

    return nil
end

local function backpackHasPetKey(key)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local character = getCharacter()

    for _, container in ipairs({ backpack, character }) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and tostring(petKeyOf(tool) or "") == tostring(key) then
                    return true, tool
                end
            end
        end
    end

    return false, nil
end

local function getMountedPetKey(plot, placedPets)
    local main = PlayerGui:FindFirstChild("Main")
    local actions = main and main:FindFirstChild("ActionsHolder")
    local dismount = actions and actions:FindFirstChild("Dismount")

    if not dismount or not dismount:IsA("GuiObject") or not dismount.Visible then
        return nil
    end

    local root = getRoot()
    if not root then
        return nil
    end

    local nearestKey = nil
    local nearestDistance = math.huge

    for _, record in ipairs(placedPets) do
        if record.Position then
            local distance = (record.Position - root.Position).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearestKey = record.Key
            end
        end
    end

    -- Mounted pet is normally physically attached very close to the player.
    if nearestDistance <= 25 then
        return nearestKey
    end

    return nil
end


local function getPlotFloorTop(plot)
    local ground = getPlotGroundPart(plot)
    if not ground then
        return nil, nil
    end

    local top = ground.CFrame:PointToWorldSpace(Vector3.new(0, ground.Size.Y / 2, 0))
    return ground, top.Y
end

local function buildExtraPetPositions(plot, existingPositions, needed)
    local result = {}

    for _, pos in ipairs(existingPositions) do
        table.insert(result, pos)
    end

    if #result >= needed then
        return result
    end

    local ground, floorY = getPlotFloorTop(plot)
    if not ground then
        return result
    end

    local yOffset = 2.7
    if #existingPositions > 0 then
        local total = 0
        for _, pos in ipairs(existingPositions) do
            total += (pos.Y - floorY)
        end
        yOffset = total / #existingPositions
    end

    local xSpan = math.max(6, math.min(ground.Size.X * 0.28, 18))
    local zSpan = math.max(6, math.min(ground.Size.Z * 0.28, 18))

    local offsets = {
        Vector3.new(-xSpan * 0.35, 0, -zSpan * 0.25),
        Vector3.new( xSpan * 0.35, 0, -zSpan * 0.25),
        Vector3.new(-xSpan * 0.18, 0,  zSpan * 0.10),
        Vector3.new( xSpan * 0.18, 0,  zSpan * 0.10),
        Vector3.new(0, 0, -zSpan * 0.50),
        Vector3.new(0, 0,  zSpan * 0.30),
        Vector3.new(-xSpan * 0.45, 0,  zSpan * 0.30),
        Vector3.new( xSpan * 0.45, 0,  zSpan * 0.30),
    }

    for _, offset in ipairs(offsets) do
        if #result >= needed then
            break
        end

        local world = ground.CFrame:PointToWorldSpace(
            Vector3.new(offset.X, ground.Size.Y / 2 + yOffset, offset.Z)
        )

        local clear = true
        for _, used in ipairs(result) do
            if horizontalDistance(world, used) < 3 then
                clear = false
                break
            end
        end

        if clear then
            table.insert(result, world)
        end
    end

    return result
end

local function getBackpackPetRecords()
    local records = {}
    local seen = {}

    local function scan(container)
        if not container then
            return
        end

        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") then
                local key = petKeyOf(tool)
                if key and not seen[key] then
                    seen[key] = true
                    table.insert(records, {
                        Key = key,
                        Object = tool,
                        Speed = 0,
                        Weight = readPetWeight(tool),
                        Placed = false,
                    })
                end
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("Backpack"))
    scan(getCharacter())

    return records
end

local function waitForPlacedPet(plot, key, timeout)
