local function petKeySetsDiffer(a, b)
    for key in pairs(a) do
        if not b[key] then
            return true
        end
    end

    for key in pairs(b) do
        if not a[key] then
            return true
        end
    end

    return false
end

local function fireButtonConnections(signal, ...)
    if type(getconnections) ~= "function" then
        return false, 0
    end

    local ok, connections = pcall(function()
        return getconnections(signal)
    end)

    if not ok or not connections then
        return false, 0
    end

    local fired = false
    local attempted = 0
    local args = table.pack(...)

    for _, connection in ipairs(connections) do
        attempted += 1

        local success = false

        -- Synapse-style / compatible connection object.
        if type(connection.Fire) == "function" then
            success = pcall(function()
                connection:Fire(table.unpack(args, 1, args.n))
            end)
        end

        -- Some executors expose the connected callback itself.
        if not success and type(connection.Function) == "function" then
            success = pcall(function()
                connection.Function(table.unpack(args, 1, args.n))
            end)
        end

        fired = fired or success
    end

    return fired, attempted
end

local function physicalClick(button)
    if not button or not button:IsA("GuiButton") then
        return false
    end

    local pos = button.AbsolutePosition
    local size = button.AbsoluteSize

    if size.X <= 2 or size.Y <= 2 then
        return false
    end

    local x = math.floor(pos.X + size.X / 2)
    local y = math.floor(pos.Y + size.Y / 2)

    if type(mousemoveabs) == "function"
        and type(mouse1press) == "function"
        and type(mouse1release) == "function" then

        local ok = pcall(function()
            mousemoveabs(x, y)
            task.wait(0.08)
            mouse1press()
            task.wait(0.08)
            mouse1release()
        end)

        if ok then
            return true
        end
    end

    if type(mousemoveabs) == "function" and type(mouse1click) == "function" then
        local ok = pcall(function()
            mousemoveabs(x, y)
            task.wait(0.08)
            mouse1click()
        end)

        if ok then
            return true
        end
    end

    local okVim, vim = pcall(function()
        return game:GetService("VirtualInputManager")
    end)

    if okVim and vim then
        for _, yOffset in ipairs({0, 36}) do
            local ok = pcall(function()
                vim:SendMouseMoveEvent(x, y + yOffset, game)
                task.wait(0.06)
                vim:SendMouseButtonEvent(x, y + yOffset, 0, true, game, 0)
                task.wait(0.08)
                vim:SendMouseButtonEvent(x, y + yOffset, 0, false, game, 0)
            end)

            if ok then
                return true
            end
        end
    end

    return false
end

local function waitForPlaceBestChange(beforeKeys, beforeCount, timeout)
    local deadline = os.clock() + (timeout or 4)

    while os.clock() < deadline do
        local afterKeys = getPlacedPetKeySet()
        local afterCount = 0

        for _ in pairs(afterKeys) do
            afterCount += 1
        end

        if afterCount ~= beforeCount or petKeySetsDiffer(beforeKeys, afterKeys) then
            return true, afterCount
        end

        task.wait(0.1)
    end

    return false, beforeCount
end

local function snapshotPlacedPets()
    local set = {}
    local count = 0
    local plot = getOwnedPlot()
    local pets = plot and plot:FindFirstChild("Pets")

    if pets then
        for _, pet in ipairs(pets:GetChildren()) do
            local key = petKeyOf(pet)
            if key then
                key = tostring(key)
                if not set[key] then
                    set[key] = true
                    count += 1
                end
            end
        end
    end

    return set, count
end

local function placedPetsChanged(beforeSet, beforeCount)
    local afterSet, afterCount = snapshotPlacedPets()

    if afterCount ~= beforeCount then
        return true, afterCount
    end

    for key in pairs(beforeSet) do
        if not afterSet[key] then
            return true, afterCount
        end
    end

    for key in pairs(afterSet) do
        if not beforeSet[key] then
            return true, afterCount
        end
    end

    return false, afterCount
end

local function waitForNativeBestChange(beforeSet, beforeCount, seconds)
    local deadline = os.clock() + (seconds or 2)

    while os.clock() < deadline do
        local changed, count = placedPetsChanged(beforeSet, beforeCount)
        if changed then
            return true, count
        end
        task.wait(0.08)
    end

    return false, beforeCount
end

local function safeConstants(fn)
    local getters = {
        debug and debug.getconstants,
        getconstants,
    }

    for _, getter in ipairs(getters) do
        if type(getter) == "function" then
            local ok, constants = pcall(getter, fn)
            if ok and type(constants) == "table" then
                return constants
            end
        end
    end

    return {}
end

local function safeFunctionScript(fn)
    local envGetters = {
        getfenv,
    }

    for _, getter in ipairs(envGetters) do
        if type(getter) == "function" then
            local ok, env = pcall(getter, fn)
            if ok and type(env) == "table" then
                local scriptObj = rawget(env, "script")
                if typeof(scriptObj) == "Instance" then
                    local okPath, path = pcall(function()
                        return scriptObj:GetFullName()
                    end)
                    if okPath then
                        return path
                    end
                end
            end
        end
    end

    if debug and type(debug.info) == "function" then
        local ok, source = pcall(function()
            return debug.info(fn, "s")
        end)
        if ok and source then
            return tostring(source)
        end
    end

    return ""
end

local function candidateFunctionScore(fn)
    local score = 0
    local constants = safeConstants(fn)

    for _, constant in ipairs(constants) do
        if type(constant) == "string" then
            local lower = string.lower(constant)

            if lower == "placebest" or lower == "place best" then
                score += 100
            elseif string.find(lower, "placebest", 1, true) then
                score += 80
            elseif lower == "placepet" then
                score += 30
            elseif lower == "pickuppet" then
                score += 30
            elseif lower == "petcollect" then
                score += 12
            elseif string.find(lower, "petstracker", 1, true) then
                score += 20
            elseif string.find(lower, "best", 1, true)
                and string.find(lower, "pet", 1, true) then
                score += 15
            end
        end
    end

    local source = string.lower(safeFunctionScript(fn))

    if string.find(source, "pet", 1, true) then
        score += 8
    end
    if string.find(source, "tracker", 1, true) then
        score += 8
    end
    if string.find(source, "main", 1, true) then
        score += 2
    end

    return score
end

local function tryCallingNativeFunction(fn, selfValue)
    if type(fn) ~= "function" then
        return false
    end

    -- Prefer zero-arg closures. Native UI callbacks usually capture all needed
    -- state in upvalues and require no explicit arguments.
    if debug and type(debug.info) == "function" then
        local okInfo, numParams, isVararg = pcall(function()
            return debug.info(fn, "a")
        end)

        if okInfo and type(numParams) == "number" then
            if numParams == 0 then
                return pcall(fn)
            elseif numParams == 1 and selfValue ~= nil then
                return pcall(fn, selfValue)
            else
                return false
            end
        end
    end

    if selfValue ~= nil then
        local ok = pcall(fn, selfValue)
        if ok then
            return true
        end
    end

    return pcall(fn)
end

local function tryNativeTableControllers(beforeSet, beforeCount)
    if type(getgc) ~= "function" then
        return false, "getgc unavailable"
    end

    local okGC, objects = pcall(function()
        return getgc(true)
    end)

    if not okGC or type(objects) ~= "table" then
        return false, "getgc failed"
    end

    local methodNames = {
        "PlaceBest",
        "placeBest",
        "PLACE_BEST",
        "EquipBest",
        "equipBest",
    }

    local attempted = 0

    for _, object in ipairs(objects) do
        if type(object) == "table" then
            for _, methodName in ipairs(methodNames) do
                local fn = rawget(object, methodName)

                if type(fn) == "function" then
                    attempted += 1

                    tryCallingNativeFunction(fn, object)
                    task.wait(0.15)

                    local changed, count =
                        waitForNativeBestChange(beforeSet, beforeCount, 1.3)

                    if changed then
                        return true, string.format(
                            "Native controller.%s worked (%d pets)",
                            methodName,
                            count
                        )
                    end
                end
            end
        end
    end

    return false, "table controllers tried=" .. tostring(attempted)
end

local function tryNativeGCClosures(beforeSet, beforeCount)
    if type(getgc) ~= "function" then
        return false, "getgc unavailable"
    end

    local okGC, objects = pcall(function()
        return getgc(true)
    end)

    if not okGC or type(objects) ~= "table" then
        return false, "getgc failed"
    end

    local candidates = {}

    for _, object in ipairs(objects) do
        if type(object) == "function" then
            local score = candidateFunctionScore(object)

            -- High threshold avoids calling unrelated random client functions.
            if score >= 35 then
                table.insert(candidates, {
                    Function = object,
                    Score = score,
                    Source = safeFunctionScript(object),
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.Score > b.Score
    end)

    local maxAttempts = math.min(#candidates, 18)

    for i = 1, maxAttempts do
        local candidate = candidates[i]

        local okCall = tryCallingNativeFunction(candidate.Function, nil)
        if okCall then
            task.wait(0.15)

            local changed, count =
                waitForNativeBestChange(beforeSet, beforeCount, 1.4)

            if changed then
                return true, string.format(
                    "Native Place Best closure worked | score=%d | pets=%d",
                    candidate.Score,
                    count
                )
            end
        end
    end

    return false, string.format(
        "native closure candidates=%d tried=%d",
        #candidates,
        maxAttempts
    )
end

local function tryNativeButtonConnections(button, beforeSet, beforeCount)
    if type(getconnections) ~= "function" then
        return false, "getconnections unavailable"
    end

    local signals = {
        button.Activated,
        button.MouseButton1Click,
        button.MouseButton1Down,
        button.MouseButton1Up,
    }

    local total = 0

    for _, signal in ipairs(signals) do
        local ok, connections = pcall(function()
            return getconnections(signal)
        end)

        if ok and type(connections) == "table" then
            for _, connection in ipairs(connections) do
                total += 1

                local called = false

                if type(connection.Fire) == "function" then
                    called = pcall(function()
                        connection:Fire()
                    end)
                end

                if not called and type(connection.Function) == "function" then
                    called = pcall(connection.Function)
                end

                if called then
                    task.wait(0.12)

                    local changed, count =
                        waitForNativeBestChange(beforeSet, beforeCount, 1.1)

                    if changed then
                        return true, string.format(
                            "Native button connection worked (%d pets)",
                            count
                        )
                    end
                end
            end
        end
    end

    return false, "button connections tried=" .. tostring(total)
end

local function parseMultiplierText(textValue)
    local n = tonumber(tostring(textValue or ""):match("x%s*([%d%.]+)"))
    return n or 1
end

local function mutationCashMultiplier(name)
    if not name or tostring(name) == "" or tostring(name) == "nil" then
        return 1
    end

    name = tostring(name)

    local main = PlayerGui:FindFirstChild("Main")
    local index = main and main:FindFirstChild("Index")
    local holders = index and index:FindFirstChild("Holders")
    local mutationsHolder = holders and holders:FindFirstChild("MutationsHolder")

    if mutationsHolder then
        for _, obj in ipairs(mutationsHolder:GetDescendants()) do
            if obj.Name == name then
                local cash = obj:FindFirstChild("CashMultiplier", true)
                if cash and cash:IsA("TextLabel") then
                    return parseMultiplierText(cash.Text)
                end
            end
        end
    end

    -- Known hatch mutations from the game's own mutation index.
    local fallback = {
        Gold = 2,
        Diamond = 3,
        Rainbow = 10,
    }

    return fallback[name] or 1
end

local function loadPetIncomeData()
    local gameData = ReplicatedStorage:FindFirstChild("GameData")
    local module = gameData and gameData:FindFirstChild("Pets")

    if not module or not module:IsA("ModuleScript") then
        return nil
    end

    local ok, data = pcall(require, module)
    if ok and type(data) == "table" then
        return data
    end

    return nil
end

local function petRecordFromObject(obj, placed)
    if not obj then
        return nil
    end

    local key = obj:GetAttribute("PetKey")
    if not key then
        return nil
    end

    local petName = obj:GetAttribute("PetName")
    if not petName or tostring(petName) == "" then
        petName = obj.Name:match("^([^%[]+)") or obj.Name
        petName = tostring(petName):gsub("%s+$", "")
    end

    local weight = tonumber(obj:GetAttribute("Weight")) or 10
    local mutation = obj:GetAttribute("Mutation")
    local spawnMutation = obj:GetAttribute("SpawnMutation")

    return {
        Key = tostring(key),
        Name = tostring(petName),
        Weight = weight,
        Mutation = mutation,
        SpawnMutation = spawnMutation,
        Object = obj,
        Placed = placed == true,
        Position = placed and getPetWorldPosition(obj) or nil,
    }
end

local function collectAllPetRecords(plot)
    local records = {}
    local seen = {}

    local function add(obj, placed)
        local record = petRecordFromObject(obj, placed)
        if record and not seen[record.Key] then
            seen[record.Key] = true
            table.insert(records, record)
        end
    end

    local pets = plot and plot:FindFirstChild("Pets")
    if pets then
        for _, pet in ipairs(pets:GetChildren()) do
            add(pet, true)
        end
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("PetKey") then
                add(tool, false)
            end
        end
    end

    local character = getCharacter()
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("PetKey") then
                add(tool, false)
            end
        end
    end

    return records
end

local function calculatePetIncomeScore(record, petData)
    local species = petData and petData[record.Name]
    local baseIncome = species and tonumber(species.Income) or 0

    if baseIncome <= 0 then
        return 0
    end

    -- The game exposes WeightStandardKG = 10 in PetAging, and the observed
    -- tracker income matches base Income * (Weight / 10), then mutations.
    local weightMultiplier = math.max(0.01, (tonumber(record.Weight) or 10) / 10)

    local mutationMultiplier = mutationCashMultiplier(record.Mutation)
    local spawnMultiplier = mutationCashMultiplier(record.SpawnMutation)

    return baseIncome
        * weightMultiplier
        * mutationMultiplier
        * spawnMultiplier
end

local function getMaxPets()
    local attr = tonumber(LocalPlayer:GetAttribute("MaxPets"))
    if attr and attr > 0 then
        return math.floor(attr)
    end

    local main = PlayerGui:FindFirstChild("Main")
    local tracker = main and main:FindFirstChild("PetsTracker")
    local header = tracker and tracker:FindFirstChild("Header")
    local cap = header and header:FindFirstChild("Capacity")

    if cap and cap:IsA("TextLabel") then
        local _, maximum = tostring(cap.Text):match("(%d+)%s*/%s*(%d+)")
        maximum = tonumber(maximum)
        if maximum and maximum > 0 then
            return maximum
        end
    end

    return 5
end

local function waitUntilPetRemoved(plot, key, timeout)
    local deadline = os.clock() + (timeout or 3)

    while os.clock() < deadline do
        if not findPlacedPetByKey(plot, key) then
            return true
        end
        task.wait(0.06)
    end

    return false
end

local function waitUntilPetPlaced(plot, key, timeout)
    local deadline = os.clock() + (timeout or 3)

    while os.clock() < deadline do
        local model = findPlacedPetByKey(plot, key)
        if model then
            return model
        end
        task.wait(0.06)
    end

    return nil
end

local function getValidPetPlacementPositions(plot, needed, preferred)
    local result = {}

    -- First reuse exact locations from pets that were removed.
    for _, pos in ipairs(preferred or {}) do
        if pos then
            -- PlacePet positions in the native recorder sit about 3 studs
            -- above the final pet model position.
            table.insert(result, pos + Vector3.new(0, 3.2, 0))
            if #result >= needed then
                return result
            end
        end
    end

    local baseplate = plot and plot:FindFirstChild("Baseplate")
    if not baseplate or not baseplate:IsA("BasePart") then
        baseplate = getPlotGroundPart(plot)
    end

    if not baseplate then
        return result
    end

    local y = baseplate.Size.Y / 2 + 3.2
    local x = math.max(6, baseplate.Size.X * 0.28)
    local z = math.max(6, baseplate.Size.Z * 0.28)

    local offsets = {
        Vector3.new(-x * 0.45, y, -z * 0.25),
        Vector3.new(-x * 0.15, y, -z * 0.25),
        Vector3.new( x * 0.15, y, -z * 0.25),
        Vector3.new( x * 0.45, y, -z * 0.25),
        Vector3.new(-x * 0.45, y,  z * 0.15),
        Vector3.new(-x * 0.15, y,  z * 0.15),
        Vector3.new( x * 0.15, y,  z * 0.15),
        Vector3.new( x * 0.45, y,  z * 0.15),
        Vector3.new(-x * 0.30, y,  z * 0.48),
        Vector3.new(0,         y,  z * 0.48),
        Vector3.new( x * 0.30, y,  z * 0.48),
    }

    local occupied = getExistingPetPositions(plot)

    for _, localOffset in ipairs(offsets) do
        if #result >= needed then
            break
        end

        local world = baseplate.CFrame:PointToWorldSpace(localOffset)
        local clear = true

        for _, pos in ipairs(occupied) do
            if horizontalDistance(world, pos) < 4 then
                clear = false
                break
            end
        end

        if clear then
            for _, pos in ipairs(result) do
                if horizontalDistance(world, pos) < 4 then
                    clear = false
                    break
                end
            end
        end

        if clear then
            table.insert(result, world)
        end
    end

    return result
end

local function pressPlaceBest()
    local gameRemotes = getRideGameRemotes()
    local placePet = gameRemotes and gameRemotes:FindFirstChild("PlacePet")
    local pickupPet = gameRemotes and gameRemotes:FindFirstChild("PickupPet")
    local petCollect = gameRemotes and gameRemotes:FindFirstChild("PetCollect")

    if not placePet or not placePet:IsA("RemoteEvent") then
        return false, "PlacePet remote not found"
    end

    if not pickupPet or not pickupPet:IsA("RemoteEvent") then
        return false, "PickupPet remote not found"
    end

    local plot = getOwnedPlot()
    if not plot then
        return false, "Your plot was not found"
    end

    local petData = loadPetIncomeData()
    if not petData then
        return false, "GameData.Pets could not be loaded"
    end

    local capacity = getMaxPets()
    local records = collectAllPetRecords(plot)

    if #records == 0 then
        return false, "No pets found"
    end

    for _, record in ipairs(records) do
        record.Score = calculatePetIncomeScore(record, petData)
    end

    table.sort(records, function(a, b)
        if a.Score == b.Score then
            return a.Weight > b.Weight
        end
        return a.Score > b.Score
    end)

    local desired = {}
    local desiredKeys = {}

    for i = 1, math.min(capacity, #records) do
        desired[i] = records[i]
        desiredKeys[records[i].Key] = true
    end

    local removedPositions = {}
    local removedCount = 0

    -- Remove every currently active pet that is not in the real top set.
    local petsFolder = plot:FindFirstChild("Pets")
    if petsFolder then
        local activeSnapshot = petsFolder:GetChildren()

        for _, pet in ipairs(activeSnapshot) do
            local key = pet:GetAttribute("PetKey")
            if key then
                key = tostring(key)

                if not desiredKeys[key] then
                    local pos = getPetWorldPosition(pet)
                    if pos then
                        table.insert(removedPositions, pos)
                    end

                    if petCollect and petCollect:IsA("RemoteEvent") then
                        pcall(function()
                            petCollect:FireServer(key)
                        end)
                        task.wait(0.04)
                    end

                    pcall(function()
                        pickupPet:FireServer(key)
                    end)

                    if waitUntilPetRemoved(
                        plot,
                        key,
                        Farm.Config.PetReplicationTimeout
                    ) then
                        removedCount += 1
                    end

                    task.wait(0.12)
                end
            end
        end
    end

    -- Allow picked pets to replicate into the backpack.
    task.wait(0.45)

    local missing = {}
    for _, record in ipairs(desired) do
        if not findPlacedPetByKey(plot, record.Key) then
            table.insert(missing, record)
        end
    end

    if #missing == 0 then
        return true, string.format(
            "Place Best: already optimal %d/%d",
            math.min(capacity, #desired),
            capacity
        )
    end

    local positions = getValidPetPlacementPositions(
        plot,
        #missing,
        removedPositions
    )

    if #positions < #missing then
        return false, string.format(
            "Only %d/%d valid pet positions found",
            #positions,
            #missing
        )
    end

    local placedCount = 0

    for index, record in ipairs(missing) do
        local position = positions[index]

        -- Wait until this PetKey is actually in Backpack/Character before
        -- asking the server to place it.
        local inventoryDeadline =
            os.clock() + Farm.Config.PetReplicationTimeout

        while os.clock() < inventoryDeadline do
            if backpackHasPetKey(record.Key) then
                break
            end
            task.wait(0.06)
        end

        pcall(function()
            placePet:FireServer(record.Key, position)
        end)

        local model = waitUntilPetPlaced(
            plot,
            record.Key,
            Farm.Config.PetReplicationTimeout
        )

        if model then
            placedCount += 1
        end

        -- Native Place Best recorder showed roughly 0.2s between PlacePet calls.
        task.wait(0.22)
    end

    local finalPets = plot:FindFirstChild("Pets")
    local finalCount = finalPets and #finalPets:GetChildren() or 0

    local names = {}
    for _, record in ipairs(desired) do
        table.insert(
            names,
            string.format("%s %.0f", record.Name, record.Score)
        )
    end

    return placedCount > 0 or finalCount >= math.min(capacity, #desired),
        string.format(
            "Place Best: %d/%d | removed %d | placed %d | %s",
            finalCount,
            capacity,
            removedCount,
            placedCount,
            table.concat(names, ", ")
        )
end

local function getPetInventorySignature()
    local parts = {}

    local function scan(container, prefix)
        if not container then
            return
        end

        for _, obj in ipairs(container:GetChildren()) do
            local key = obj:GetAttribute("PetKey")
            if key then
                table.insert(
                    parts,
                    prefix .. ":" .. tostring(key)
                )
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("Backpack"), "B")
    scan(getCharacter(), "C")

    local plot = getOwnedPlot()
    local pets = plot and plot:FindFirstChild("Pets")
    scan(pets, "P")

    table.sort(parts)
    return table.concat(parts, "|")
end

local function waitForNewPetAfterHatch(beforeSignature, timeout)
    local deadline = os.clock() + (timeout or 3.5)

    while os.clock() < deadline do
        local now = getPetInventorySignature()

        if now ~= beforeSignature then
            return true
        end

        task.wait(0.08)
    end

    return false
end

local function hatchReadyEggsAndPlaceBest()
    local plot = getOwnedPlot()
    if not plot then
        return false, "Your plot was not found"
    end

    local readyEggs = getReadyEggModels(plot)
    if #readyEggs == 0 then
        return false, "No ready eggs"
    end

    local beforeSignature = getPetInventorySignature()
    local hatched = 0

    for _, egg in ipairs(readyEggs) do
        if not Farm.Alive then
            break
        end

        local ok = hatchEggModelDirect(egg)

        if ok then
            hatched += 1
            task.wait(0.25)
        end
    end

    if hatched <= 0 then
        return false, "Ready egg detected but Hatch was not accepted"
    end

    -- Important: Place Best was working when called AFTER the hatched pet
    -- actually appeared. Wait for inventory/plot replication first.
    waitForNewPetAfterHatch(
        beforeSignature,
        math.max(Farm.Config.HatchDelay + 2.0, 3.0)
    )

    task.wait(math.max(Farm.Config.HatchDelay, 0.8))

    local refreshed, message = pressPlaceBest()

    if refreshed then
        return true, string.format(
            "Hatched %d egg(s); %s",
            hatched,
            message
        )
    end

    return true, string.format(
        "Hatched %d egg(s); Place Best: %s",
        hatched,
        message
    )
end

task.spawn(function()
