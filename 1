-- Main farm loop.
task.spawn(function()
    while Farm.Alive do
        if Farm.AutomationBusy then
            task.wait(0.15)
        elseif Farm.Enabled then
            if selectedCount() == 0 then
                setFarmStatus("Select at least one egg")
                task.wait(0.35)
            else
                local target = getBestTarget()

                if target then
                    setFarmStatus("Farming: " .. target.Name)

                    local targetCFrame = getTargetCFrame(target)
                    if targetCFrame then
                        local useTeleport = Farm.TeleportFarmEnabled
                            and os.clock() >= Farm.TeleportRejectedUntil
                        local reached
                        if useTeleport then
                            reached = teleportToTarget(target)
                        else
                            reached = moveToPosition(targetCFrame.Position, target)
                        end

                        if useTeleport and not reached and Farm.Enabled and target.Parent then
                            useTeleport = false
                            reached = moveToPosition(targetCFrame.Position, target)
                        end

                        if Farm.Enabled and reached and target.Parent then
                            interactWithTarget(target, Farm.Config.AutoFarmHoldTime)

                            if Farm.Enabled then
                                setFarmStatus("Dropping off...")
                                returnToPlot(useTeleport)
                                task.wait(0.5)
                            end
                        end
                    end
                else
                    setFarmStatus("Waiting for selected eggs...")
                    task.wait(0.35)
                end
            end
        else
            task.wait(0.2)
        end
    end
end)

