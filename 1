    })
    UI.Window = Window

    --==================== MAIN ====================--
    local mainTab = Window:AddTab("@tab.main")

    local infoSection = mainTab:AddSection("@main.info")
    UI.StatusLabel = infoSection:AddLabel("Status: " .. Farm.Status)
    UI.SelectedLabel = infoSection:AddLabel("Selected eggs: 0")
    UI.SpawnedCountLabel = infoSection:AddLabel("Spawned eggs detected: 0")
    infoSection:AddLabel("Anti-AFK: enabled")
    infoSection:AddLabel("Auto Farm prioritizes the highest-value selected egg that is currently spawned.")

    local farmSection = mainTab:AddSection("Auto Farm")
    UI.AutoFarmToggle = farmSection:AddToggle("Enable Auto Farm", false, function(enabled)
        setAutoFarm(enabled)
        refreshInfoLabels()

        Window:Notify({
            Title = "Crystal Hub",
            Text = enabled and "Auto Farm enabled." or "Auto Farm stopped.",
            Duration = 3,
            Kind = enabled and "success" or "info",
        })
    end, "farm_enabled")

    UI.TeleportFarmToggle = farmSection:AddToggle("Steal Eggs by Teleport", false, function(enabled)
        Farm.TeleportFarmEnabled = enabled and true or false
        Farm.TeleportRejectedUntil = 0
        setFarmStatus(enabled and "Teleport egg farm selected" or "Smooth egg farm selected")
        refreshInfoLabels()

        Window:Notify({
            Title = "Crystal Hub",
            Text = enabled
                and "Egg farming will teleport to targets and directly return to your plot."
                or "Egg farming will use smooth movement.",
            Duration = 3,
            Kind = "info",
        })
    end, "farm_teleport_eggs")

    farmSection:AddButton("Dump Client AC Candidates", function()
        task.spawn(function()
            local ok, result = dumpClientAntiCheatCandidates()
            Window:Notify({
                Title = "Crystal Hub",
                Text = ok and ("Client dump saved: " .. result) or ("Client dump failed: " .. result),
                Duration = 6,
                Kind = ok and "success" or "warning",
            })
        end)
    end, "farm_dump_client_ac")

    farmSection:AddButton("Return to My Plot", function()
        local previous = Farm.Enabled
        Farm.Enabled = true
        setFarmStatus("Returning to plot...")
        local ok = returnToPlot()
        Farm.Enabled = previous

        if not previous then
            setFarmStatus(ok and "Returned to plot" or "Plot not found")
        end

        refreshInfoLabels()
    end, "farm_return_plot")

    farmSection:AddButton("Refresh Egg Folder", function()
        local folder = refreshRenderedEggs()
        Window:Notify({
            Title = "Crystal Hub",
            Text = folder
                and string.format("RenderedEggs found (%d objects).", spawnedCount())
                or "RenderedEggs folder was not found.",
            Duration = 3,
            Kind = folder and "success" or "warning",
        })
        refreshInfoLabels()
    end, "farm_refresh_folder")

    --==================== AUTO FARM ====================--
    local autoTab = Window:AddTab("Auto Farm")

    local ranchSection = autoTab:AddSection("Ranch Automation")

    UI.AutoPlaceToggle = ranchSection:AddToggle("Auto Place Eggs", false, function(enabled)
        Farm.AutoPlaceEnabled = enabled and true or false

        Window:Notify({
            Title = "Crystal Hub",
            Text = enabled
                and "Auto Place Eggs enabled. Uses the game\'s EggPlaced remote on a free unlocked nest."
                or "Auto Place Eggs disabled.",
            Duration = 3,
            Kind = enabled and "success" or "info",
        })
    end, "ranch_auto_place_eggs")

    UI.AutoHatchBestToggle = ranchSection:AddToggle("Auto Hatch + Place Best", false, function(enabled)
        Farm.AutoHatchBestEnabled = enabled and true or false

        Window:Notify({
            Title = "Crystal Hub",
            Text = enabled
                and "Ready eggs will hatch automatically, then the game's Place Best button will be pressed."
                or "Auto Hatch + Place Best disabled.",
            Duration = 3,
            Kind = enabled and "success" or "info",
        })
    end, "ranch_auto_hatch_place_best")

    UI.AutoBestToggle = ranchSection:AddToggle("Auto Equip Best", false, function(enabled)
        Farm.AutoBestEnabled = enabled and true or false

        Window:Notify({
            Title = "Crystal Hub",
            Text = enabled
                and "Auto Equip Best enabled. It now checks independently from egg hatching."
                or "Auto Equip Best disabled.",
            Duration = 3,
            Kind = enabled and "success" or "info",
        })
    end, "ranch_auto_equip_best")

    ranchSection:AddLabel("Place Best is reproduced directly from the game's PickupPet / PlacePet remotes.")
    ranchSection:AddLabel("Auto Place equips one egg and sends the exact EggPlaced payload captured from manual placement.")
    ranchSection:AddLabel("Plot limit: 10 active eggs. Full plots wait for Ready -> Hatch -> plant next.")

    local selectionActions = autoTab:AddSection("Egg Selection")
    selectionActions:AddButton("Select All Eggs", function()
        setAllEggs(true)
        Window:Notify({
            Title = "Crystal Hub",
            Text = "All egg types selected.",
            Duration = 2.5,
            Kind = "success",
        })
    end, "farm_select_all")

    selectionActions:AddButton("Clear Selection", function()
        setAllEggs(false)
        Window:Notify({
            Title = "Crystal Hub",
            Text = "Egg selection cleared.",
            Duration = 2.5,
            Kind = "info",
        })
    end, "farm_clear_all")

    selectionActions:AddLabel("Tip: right-click any toggle to bind a hotkey.")

    local eggSection = autoTab:AddSection("Egg Types")

    -- Refresh the new egg's live value before rendering the selector.
    refreshDynamicEggValue("Volcano Egg")

    local eggEntries = {}
    for name, value in pairs(Farm.EggValues) do
        table.insert(eggEntries, { Name = name, Value = value })
    end
    table.sort(eggEntries, function(a, b)
        return a.Value > b.Value
    end)

    for _, entry in ipairs(eggEntries) do
        local eggName = entry.Name
        local flag = "egg_" .. string.lower((eggName:gsub("%s+", "_")))
        UI.EggToggles[eggName] = eggSection:AddToggle(
            string.format(
                "%s  [%s]",
                eggName,
                (tonumber(entry.Value) or 0) > 0 and formatNumber(entry.Value) or "NEW"
            ),
            false,
            function(enabled)
                Farm.Selected[eggName] = enabled and true or false

                if Farm.Enabled and selectedCount() == 0 then
                    setFarmStatus("Select at least one egg")
                end

                refreshInfoLabels()
            end,
            flag
        )
    end

    --==================== PLAYER ====================--
    local playerTab = Window:AddTab("Player")

    local movementSection = playerTab:AddSection("Movement")
    movementSection:AddSlider(
        "Movement Speed",
        50,
        600,
        Farm.Config.MovementSpeed,
        function(value)
            Farm.Config.MovementSpeed = value
        end,
        10,
        "farm_move_speed"
    )

    movementSection:AddSlider(
        "Fly Height",
        3,
        30,
        Farm.Config.FlyHeight,
        function(value)
            Farm.Config.FlyHeight = value
        end,
        1,
        "farm_fly_height"
    )

    local interactionSection = playerTab:AddSection("Interaction")
    interactionSection:AddSlider(
        "Teleport Height",
        0,
        10,
        Farm.Config.TPHeightOffset,
        function(value)
            Farm.Config.TPHeightOffset = value
        end,
        1,
        "farm_tp_height"
    )

    interactionSection:AddSlider(
        "Interaction Hold Time",
        1,
        15,
        Farm.Config.AutoFarmHoldTime,
        function(value)
            Farm.Config.AutoFarmHoldTime = value
        end,
        0.5,
        "farm_hold_time"
    )

    interactionSection:AddButton("Unanchor Character", function()
        local root = getRoot()
        if root then
            root.Anchored = false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            Window:Notify({
                Title = "Crystal Hub",
                Text = "Character unanchored.",
                Duration = 2.5,
                Kind = "success",
            })
        end
    end, "farm_unanchor")

    --==================== TELEPORT ====================--
    local teleportTab = Window:AddTab("Teleport")

    local plotSection = teleportTab:AddSection("Plot")
    plotSection:AddButton("Teleport / Return to My Plot", function()
        local previous = Farm.Enabled
        Farm.Enabled = true
        setFarmStatus("Returning to plot...")
        local ok = returnToPlot()
        Farm.Enabled = previous

        if not previous then
            setFarmStatus(ok and "Returned to plot" or "Plot not found")
        end

        Window:Notify({
            Title = "Crystal Hub",
            Text = ok and "Returned to your plot." or "Your plot could not be found.",
            Duration = 3,
            Kind = ok and "success" or "warning",
        })
    end, "tp_my_plot")

    local spawnedSection = teleportTab:AddSection("Spawned Eggs")
    UI.SpawnedListLabel = spawnedSection:AddLabel(buildSpawnedSummary())

    spawnedSection:AddButton("Refresh Spawned List", function()
        refreshRenderedEggs()
        if UI.SpawnedListLabel then
            UI.SpawnedListLabel:Set(buildSpawnedSummary())
        end
        refreshInfoLabels()
    end, "spawned_refresh")

    --==================== SETTINGS ====================--
    local settingsTab = Window:AddTab("@tab.settings")

    local interfaceSection = settingsTab:AddSection("@set.interface")
    interfaceSection:AddDropdown(
        "@set.theme",
        Library:GetThemes(),
        Library.CurrentTheme,
        function(choice)
            Library:SetTheme(choice)
        end,
        "ui_theme"
    )

    interfaceSection:AddToggle("@set.sounds", true, function(enabled)
        Sounds.Enabled = enabled and true or false
    end, "ui_sounds")

    interfaceSection:AddSlider("@set.volume", 0, 1, Sounds.Volume, function(value)
        Sounds.Volume = value
    end, 0.05, "ui_volume")

    interfaceSection:AddToggle("@set.clamp", true, function(enabled)
        Window:SetClamp(enabled)
    end, "ui_clamp")

    local floatingVisible = true
    interfaceSection:AddToggle("@set.button", true, function(enabled)
        floatingVisible = enabled and true or false
        if UI.FloatingButton then
            UI.FloatingButton:SetVisible(floatingVisible)
        end
    end, "ui_floating")

    interfaceSection:AddButton("@set.hide", function()
        Window:Toggle()
    end, "ui_hide")

    local configSection = settingsTab:AddSection("@set.config")
    local configName = "default"

    configSection:AddTextbox("@set.configName", "default", "default", function(value)
        value = tostring(value or "")
        if value ~= "" then
            configName = value
        end
    end, "config_name")

    configSection:AddButton("@set.save", function()
        local ok = Window:SaveConfig(configName)
        Window:Notify({
            Title = "Crystal Hub",
            Text = ok and ("Saved config: " .. configName) or "Could not save config.",
            Duration = 3,
            Kind = ok and "success" or "warning",
        })
    end, "config_save")

    configSection:AddButton("@set.load", function()
        local ok = Window:LoadConfig(configName)
        Window:Notify({
            Title = "Crystal Hub",
            Text = ok and ("Loaded config: " .. configName) or "Could not load config.",
            Duration = 3,
            Kind = ok and "success" or "warning",
        })
        task.delay(0.1, refreshInfoLabels)
    end, "config_load")

    local utilitySection = settingsTab:AddSection("Utility")
    utilitySection:AddButton("Unload Crystal Hub", function()
        Library:Unload()
    end, "ui_unload")

    UI.FloatingButton = Library:CreateFloatingButton({
        Style = "circle",
        Callback = function()
            if UI.Window and UI.Window.Gui and UI.Window.Gui.Parent then
                UI.Window:Toggle()
            end
        end,
    })

    UI.FloatingButton:SetVisible(floatingVisible)

    -- Live status and spawned list refresh.
    task.spawn(function()
        while Farm.Alive and Window.Gui and Window.Gui.Parent do
            refreshInfoLabels()

            if UI.SpawnedListLabel then
                UI.SpawnedListLabel:Set(buildSpawnedSummary())
            end

            task.wait(0.5)
        end
    end)

    Window:Notify({
        Title = "Crystal Hub",
        Text = DeviceProfile.Mobile
            and "Tap the crystal button to hide or open."
            or "Right Ctrl — hide or open.",
        Duration = 5,
        Kind = "success",
    })
end

local loader = Library:CreateLoader({
    Title = "Crystal Hub",
    Subtitle = "made by skobliko",
})

loader:Run(nil, buildInterface)
