local CrystalEggTypeSelection = {}
local CrystalEggTypeDisplayToName = {}

local function crystalCanonicalEggName(value)
    local text = string.lower(tostring(value or ""))
    text = text:gsub("[%s_%-]+", "")

    -- Known game-name aliases.
    if text == "blackholeegg" or text == "blackhole" then
        return "blackholeegg"
    end
    if text == "volcanoegg" or text == "volcanicegg" or text == "volcanic" then
        return "volcanicegg"
    end

    return text
end

-- The value scale shown by the earlier Crystal Hub selector. SellPrice is the
-- separate resale field and is often $5, so it must not label this list.
local CrystalEggValues = {
    whiteegg = 1, brownegg = 5, crackedegg = 30, easteregg = 50,
    stoneegg = 100, leafegg = 200, mushroomegg = 500, floweregg = 750,
    slimeegg = 1000, iceegg = 3000, glassegg = 10000,
    goldenegg = 30000, diamondegg = 90000, crystalegg = 150000,
    skullegg = 250000, asteroidegg = 500000, dominusegg = 700000,
    flamingegg = 1000000, sinisteregg = 3000000, soulegg = 7000000,
    auroraegg = 300000000, galaxyegg = 1500000000,
    blackholeegg = 100000000000, solarisegg = 300000000000,
    cherubegg = 1000000000000,
}

local function crystalEggValue(name, info)
    local known = CrystalEggValues[crystalCanonicalEggName(name)]
    if known then return known end
    if type(info) == "table" then
        for _, field in ipairs({ "Luck", "Value", "SampleSize", "Price", "Cost", "RarityValue" }) do
            local value = tonumber(info[field])
            if value and value > 0 then return value end
        end
    end
    return nil
end

local function crystalFormatEggValue(value)
    for _, suffix in ipairs({
        { 1e33, "Dc" }, { 1e30, "No" }, { 1e27, "Oc" },
        { 1e24, "Sp" }, { 1e21, "Sx" }, { 1e18, "Qi" },
        { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" },
        { 1e6, "M" }, { 1e3, "K" },
    }) do
        if value >= suffix[1] then
            return string.format("%.1f%s", value / suffix[1], suffix[2])
        end
    end
    return tostring(math.floor(value + 0.5))
end

_G.__CrystalEggTypeAllowed = function(name)
    if next(CrystalEggTypeSelection) == nil then
        return true
    end
    return CrystalEggTypeSelection[crystalCanonicalEggName(name)] == true
end

local function getCrystalEggTypeOptions()
    local entries = {}
    local seen = {}

    local storage = game:GetService("ReplicatedStorage")
    local gameData = storage:FindFirstChild("GameData") or storage:WaitForChild("GameData", 5)
    local eggsModule = gameData and (gameData:FindFirstChild("Eggs") or gameData:WaitForChild("Eggs", 5))

    if eggsModule then
        local ok, eggs = pcall(require, eggsModule)
        if ok and type(eggs) == "table" then
            for name, info in pairs(eggs) do
                if type(name) == "string" and not seen[name] then
                    seen[name] = true
                    table.insert(entries, {
                        Name = name,
                        Value = crystalEggValue(name, info),
                    })
                end
            end
        end
    end

    -- Preserve the previous selector's known values if game data is late.
    if #entries == 0 then
        for _, name in ipairs({
            "White Egg", "Brown Egg", "Cracked Egg", "Easter Egg",
            "Stone Egg", "Leaf Egg", "Mushroom Egg", "Flower Egg",
            "Slime Egg", "Ice Egg", "Glass Egg", "Golden Egg",
            "Diamond Egg", "Crystal Egg", "Skull Egg", "Asteroid Egg",
            "Dominus Egg", "Flaming Egg", "Sinister Egg", "Soul Egg",
            "Aurora Egg", "Galaxy Egg", "Blackhole Egg", "Solaris Egg",
            "Cherub Egg", "Volcanic Egg",
        }) do
            table.insert(entries, { Name = name, Value = crystalEggValue(name) })
        end
    end

    table.sort(entries, function(a, b)
        local aValue, bValue = a.Value or -1, b.Value or -1
        if aValue ~= bValue then return aValue > bValue end
        return string.lower(a.Name) < string.lower(b.Name)
    end)

    local values = {}
    CrystalEggTypeDisplayToName = {}
    for _, entry in ipairs(entries) do
        local label
        if entry.Value then
            label = entry.Name .. " [" .. crystalFormatEggValue(entry.Value) .. "]"
        else
            label = entry.Name .. " [NEW]"
        end
        CrystalEggTypeDisplayToName[label] = entry.Name
        table.insert(values, label)
    end
    return values
end

