    while os.clock() < deadline do
        local pet = findPlacedPetByKey(plot, key)
        if pet then
            return pet
        end
        task.wait(0.05)
    end

    return nil
end

local function waitForPetRemoved(plot, key, timeout)
    local deadline = os.clock() + (timeout or 2)

    while os.clock() < deadline do
        if not findPlacedPetByKey(plot, key) then
            return true
        end
        task.wait(0.05)
    end

    return false
end

local function generateFreePetPositions(plot, count, occupiedPositions)
    local result = {}
    occupiedPositions = occupiedPositions or {}

    if count <= 0 then
        return result
    end

    local ground, floorY = getPlotFloorTop(plot)
    if not ground then
        return result
    end

    local yOffset = 3.0

    if #occupiedPositions > 0 then
        local total = 0
        for _, pos in ipairs(occupiedPositions) do
            total += (pos.Y - floorY)
        end
        yOffset = math.max(1.5, total / #occupiedPositions)
    end

    local halfX = math.max(8, ground.Size.X * 0.37)
    local halfZ = math.max(8, ground.Size.Z * 0.37)

    -- Dense deterministic grid, filtered against existing pets.
    local grid = {
        {-0.45, -0.35}, {-0.15, -0.35}, {0.15, -0.35}, {0.45, -0.35},
        {-0.45, -0.05}, {-0.15, -0.05}, {0.15, -0.05}, {0.45, -0.05},
        {-0.45,  0.25}, {-0.15,  0.25}, {0.15,  0.25}, {0.45,  0.25},
        {-0.30,  0.50}, {0.00,  0.50}, {0.30,  0.50},
    }

    local eggPositions = getExistingEggPositions(plot)

    for _, cell in ipairs(grid) do
        if #result >= count then
            break
        end

        local localPos = Vector3.new(
            cell[1] * halfX,
            ground.Size.Y / 2 + yOffset,
            cell[2] * halfZ
        )

        local world = ground.CFrame:PointToWorldSpace(localPos)
        local clear = true

        for _, used in ipairs(occupiedPositions) do
            if horizontalDistance(world, used) < 4.5 then
                clear = false
                break
            end
        end

        if clear then
            for _, used in ipairs(result) do
                if horizontalDistance(world, used) < 4.5 then
                    clear = false
                    break
                end
            end
        end

        if clear then
            for _, eggPos in ipairs(eggPositions) do
                if horizontalDistance(world, eggPos) < 4.5 then
                    clear = false
                    break
                end
            end
        end

        if clear then
            table.insert(result, world)
        end
    end

    return result
end

local function probePetSpeed(plot, placePet, pickupPet, record, probePosition)
    if not record or not record.Key or not probePosition then
        return nil, "Bad probe arguments"
    end

    -- Pet must currently be in inventory.
    local inInventory = backpackHasPetKey(record.Key)
    if not inInventory then
        return nil, "Pet not in inventory"
    end

    pcall(function()
        placePet:FireServer(record.Key, probePosition)
    end)

    local model = waitForPlacedPet(
        plot,
        record.Key,
        Farm.Config.PetProbePlaceTimeout
    )

    if not model then
        return nil, "PlacePet probe rejected"
    end

    -- This is the important difference from older builds:
    -- Data.Speed on the spawned plot model is the actual resulting value.
    local realSpeed = readPetSpeed(model)
    local realWeight = readPetWeight(model)

    pcall(function()
        pickupPet:FireServer(record.Key)
    end)

    local removed = waitForPetRemoved(
        plot,
        record.Key,
        Farm.Config.PetProbePickupTimeout
    )

    if not removed then
        return nil, "Probe PickupPet rejected"
    end

    local inventoryDeadline = os.clock() + Farm.Config.PetProbePickupTimeout
    while os.clock() < inventoryDeadline do
        local returned = backpackHasPetKey(record.Key)
        if returned then
            break
        end
        task.wait(0.05)
    end

    task.wait(Farm.Config.PetProbeDelay)

    return {
        Key = record.Key,
        Speed = tonumber(realSpeed) or 0,
        Weight = tonumber(realWeight) or record.Weight or 0,
        Placed = false,
    }
end


local INCOME_SUFFIXES = {
    [""] = 1,
    K = 1e3,
    M = 1e6,
    B = 1e9,
    T = 1e12,
    Qa = 1e15,
    Qi = 1e18,
    Sx = 1e21,
    Sp = 1e24,
    Oc = 1e27,
    No = 1e30,
    Dc = 1e33,
}

local function parseIncomeText(textValue)
    textValue = tostring(textValue or "")
    textValue = textValue:gsub(",", "")

    local numberText, suffix = textValue:match("%$([%d%.]+)([%a]*)/s")
    if not numberText then
        numberText, suffix = textValue:match("%$([%d%.]+)([%a]*)")
    end

    local number = tonumber(numberText)
    if not number then
        return 0
    end

    local multiplier = INCOME_SUFFIXES[suffix or ""] or 1
    return number * multiplier
end

local function getTrackerHolder()
    local main = PlayerGui:FindFirstChild("Main")
    local tracker = main and main:FindFirstChild("PetsTracker")
    return tracker and tracker:FindFirstChild("Holder")
end

local function readTrackerIncomeByKey(key)
    local holder = getTrackerHolder()
    if not holder or not key then
        return nil, nil
    end

    local entry = holder:FindFirstChild(tostring(key))
    if not entry then
        return nil, nil
    end

    local income = entry:FindFirstChild("Income")
    if not income or not income:IsA("TextLabel") then
        return nil, nil
    end

    return parseIncomeText(income.Text), income.Text
end

local function waitForTrackerIncome(key, timeout)
    local deadline = os.clock() + (timeout or 2.5)

    while os.clock() < deadline do
        local value, raw = readTrackerIncomeByKey(key)
        if value and value > 0 then
            return value, raw
        end
        task.wait(0.05)
    end

    return nil, nil
end

local function probePetIncome(plot, placePet, pickupPet, record, probePosition)
    if not record or not record.Key or not probePosition then
        return nil, "Bad probe arguments"
    end

    local inInventory = backpackHasPetKey(record.Key)
    if not inInventory then
        return nil, "Pet not in inventory"
    end

    pcall(function()
        placePet:FireServer(record.Key, probePosition)
    end)

    local model = waitForPlacedPet(
        plot,
        record.Key,
        Farm.Config.PetProbePlaceTimeout
    )

    if not model then
        return nil, "Probe PlacePet rejected"
    end

    local income, rawIncome = waitForTrackerIncome(
        record.Key,
        Farm.Config.PetProbePlaceTimeout
    )

    pcall(function()
        pickupPet:FireServer(record.Key)
    end)

    local removed = waitForPetRemoved(
        plot,
        record.Key,
        Farm.Config.PetProbePickupTimeout
    )

    if not removed then
        return nil, "Probe PickupPet rejected"
    end

    local inventoryDeadline = os.clock() + Farm.Config.PetProbePickupTimeout
    while os.clock() < inventoryDeadline do
        if backpackHasPetKey(record.Key) then
            break
        end
        task.wait(0.05)
    end

    task.wait(Farm.Config.PetProbeDelay)

    if not income then
        return nil, "Income label did not appear"
    end

    return {
        Key = record.Key,
        Income = income,
        IncomeText = rawIncome or "?",
        Weight = readPetWeight(model),
        Placed = false,
    }
end

local function getCurrentPlacedIncomeRecords(plot)
    local result = {}
    local petsFolder = plot and plot:FindFirstChild("Pets")

    if not petsFolder then
        return result
    end

    for _, pet in ipairs(petsFolder:GetChildren()) do
        local key = petKeyOf(pet)
        if key then
            local income, rawIncome = readTrackerIncomeByKey(key)

            if not income or income <= 0 then
                income, rawIncome = waitForTrackerIncome(key, 1.0)
            end

            table.insert(result, {
                Key = tostring(key),
                Income = tonumber(income) or 0,
                IncomeText = rawIncome or "?",
                Weight = readPetWeight(pet),
                Placed = true,
                Position = getPetWorldPosition(pet),
            })
        end
    end

    return result
end

local function sortByIncome(records)
    table.sort(records, function(a, b)
        local ai = tonumber(a.Income) or 0
        local bi = tonumber(b.Income) or 0

        if ai == bi then
            local aw = tonumber(a.Weight) or 0
            local bw = tonumber(b.Weight) or 0

            if aw == bw then
                return tostring(a.Key) < tostring(b.Key)
            end

            return aw > bw
        end

        return ai > bi
    end)
end

local function getPlacedPetKeySet()
    local result = {}
    local plot = getOwnedPlot()
    local pets = plot and plot:FindFirstChild("Pets")

    if pets then
        for _, pet in ipairs(pets:GetChildren()) do
            local key = petKeyOf(pet)
