-- A plain Roblox GUI keeps the loading window visible even if a theme/effect
-- in the Crystal loader fails on this executor or device.
if not loaderOk or not crystalLoader or not crystalLoader.Gui or not crystalLoader.Gui.Parent then
    local fallbackOk, fallbackError = pcall(function()
        local gui = Instance.new("ScreenGui")
