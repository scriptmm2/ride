			width = minWidth
		else
			width, height = expandedW, expandedH
			logo.Position = UDim2.new(0, compactMode and 10 or 14, 0, 9)
			searchBox.Visible = true
			titleLabel.Position = UDim2.new(0, titleX, 0, compactMode and 15 or 8)
