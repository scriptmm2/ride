local function moveToPosition(position, target)
    local root = getRoot()
    if not root then
        setFarmStatus("Waiting for character...")
        return false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local startPosition = root.Position
    local destination = Vector3.new(
        position.X,
        math.max(startPosition.Y, position.Y + Farm.Config.FlyHeight),
        position.Z
    )

    local platformCFrame = CFrame.new(root.Position - Vector3.new(0, 3.5, 0))
    ensurePlatform(platformCFrame)
    root.CFrame = platformCFrame + Vector3.new(0, 3.5, 0)
    task.wait(0.05)

    local horizontalDistance = (
        Vector3.new(root.Position.X, 0, root.Position.Z)
        - Vector3.new(destination.X, 0, destination.Z)
    ).Magnitude

    local duration = math.max(0.2, horizontalDistance / math.max(Farm.Config.MovementSpeed, 1))
    local startedAt = os.clock()

    while Farm.Alive and Farm.Enabled and (os.clock() - startedAt) < duration do
        if target and not target.Parent then
            return false
        end

        root = getRoot()
        if not root then
            return false
        end

        local alpha = math.min(1, (os.clock() - startedAt) / duration)
        local current = startPosition:Lerp(destination, alpha)
        local currentPlatform = CFrame.new(current - Vector3.new(0, 3.5, 0))
        ensurePlatform(currentPlatform)
        root.CFrame = currentPlatform + Vector3.new(0, 3.5, 0)

        RunService.Heartbeat:Wait()
    end

    if Farm.Alive and Farm.Enabled then
        root = getRoot()
        if root then
            local finalPlatform = CFrame.new(destination - Vector3.new(0, 3.5, 0))
            ensurePlatform(finalPlatform)
            root.CFrame = finalPlatform + Vector3.new(0, 3.5, 0)
        end
    end

    return Farm.Enabled
end

local function teleportToTarget(target)
    local root = getRoot()
    local targetCFrame = getTargetCFrame(target)
    if not Farm.Alive or not Farm.Enabled or not root or not targetCFrame then
        return false
    end

    local arrival = targetCFrame + Vector3.new(0, Farm.Config.TPHeightOffset, 0)
    ensurePlatform(arrival - Vector3.new(0, 3.5, 0))
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = arrival

    -- Wait for the server's position replication before attempting the pickup.
    task.wait(Farm.Config.TeleportConfirmDelay)
    root = getRoot()
    if not Farm.Enabled or not target.Parent or not root then
        return false
    end

    if (root.Position - arrival.Position).Magnitude > Farm.Config.TeleportCorrectionRadius then
        Farm.TeleportRejectedUntil = os.clock() + Farm.Config.TeleportRetryDelay
        setFarmStatus("Teleport corrected; using smooth movement temporarily")
        clearPlatform()
        return false
    end

    return true
end

local function dumpClientAntiCheatCandidates()
    if type(writefile) ~= "function" then
        return false, "Executor file writing is unavailable"
    end

    local roots = {
        LocalPlayer:FindFirstChild("PlayerScripts"),
        PlayerGui,
        ReplicatedStorage,
        LocalPlayer.Character,
    }
    local markers = { "anti", "cheat", "security", "exploit", "teleport", "movement", "speed" }
    local seen = {}
    local scripts = {}

    for _, root in pairs(roots) do
        if root then
            for _, item in ipairs(root:GetDescendants()) do
                if (item:IsA("LocalScript") or item:IsA("ModuleScript")) and not seen[item] then
                    seen[item] = true
                    local path = item:GetFullName()
                    local normalizedPath = lowerText(path)
                    local candidate = false
                    for _, marker in ipairs(markers) do
                        if string.find(normalizedPath, marker, 1, true) then
                            candidate = true
                            break
                        end
                    end
                    table.insert(scripts, { Object = item, Path = path, Candidate = candidate })
                end
            end
        end
    end

    table.sort(scripts, function(a, b) return a.Path < b.Path end)
    local lines = { "Crystal Hub client script inventory / anti-cheat candidates" }
    local candidateCount = 0
    for _, entry in ipairs(scripts) do
        table.insert(lines, (entry.Candidate and "CANDIDATE " or "INDEX ") .. entry.Path)
        if entry.Candidate then
            candidateCount = candidateCount + 1
            if type(decompile) == "function" then
                local ok, source = pcall(decompile, entry.Object)
                table.insert(lines, ok and type(source) == "string"
                    and string.sub(source, 1, 250000)
                    or "[decompile unavailable for this script]")
            else
                table.insert(lines, "[decompile API unavailable]")
            end
            table.insert(lines, "---")
        end
    end

    local outputPath = "CrystalHub_AC_dump.txt"
    local ok, err = pcall(writefile, outputPath, table.concat(lines, "\n"))
    if not ok then
        return false, tostring(err)
    end
    return true, string.format("%s (%d candidates / %d scripts)", outputPath, candidateCount, #scripts)
end

local function interactWithTarget(target, holdTime)
    if not target or not target.Parent then
        return false
    end

    local root = getRoot()
    local targetCFrame = getTargetCFrame(target)
    if not root or not targetCFrame then
        return false
    end

    local interactionCFrame = targetCFrame + Vector3.new(0, Farm.Config.TPHeightOffset, 0)
    ensurePlatform(interactionCFrame - Vector3.new(0, 3.5, 0))

    root.CFrame = interactionCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.Anchored = true

    local ok, result = pcall(function()
        task.wait(0.2)
        if not target.Parent then
            return false
        end

        local prompt
        for _, descendant in ipairs(target:GetDescendants()) do
            if descendant:IsA("ProximityPrompt") then
                prompt = descendant
                break
            end
        end

        if prompt then
            if type(fireproximityprompt) == "function" then
                fireproximityprompt(prompt)
                return true
            end

            prompt:InputHoldBegin()
            local duration = prompt.HoldDuration > 0 and prompt.HoldDuration or holdTime
            task.wait(math.min(holdTime, duration))
            prompt:InputHoldEnd()
            return true
        end

        task.wait(0.4)
        return false
    end)

    root = getRoot()
    if root then
        root.Anchored = false
    end

    if not ok then
        Farm.LastError = tostring(result)
        warn("[CrystalHub] interaction error: " .. tostring(result))
        return false
    end

    return result == true
end

local function getOwnedPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        return nil
    end

    for _, plot in ipairs(plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        local owner = data and data:FindFirstChild("Owner")

        if owner then
            local owned = false
            local ok = pcall(function()
                owned = typeof(owner.Value) == "Instance" and owner.Value == LocalPlayer
                if not owned then
                    owned = tostring(owner.Value) == LocalPlayer.Name
                end
            end)

            if ok and owned then
                return plot
            end
        end
    end

    return nil
end

local function returnToPlot(directTeleport)
    local plot = getOwnedPlot()
    if not plot then
        clearPlatform()
        setFarmStatus("Plot not found")
        return false
    end

    local plotCFrame = getTargetCFrame(plot)
    if not plotCFrame then
        clearPlatform()
        setFarmStatus("Plot position unavailable")
        return false
    end

    if Farm.Enabled and not directTeleport then
        moveToPosition(plotCFrame.Position, nil)
    end

    local root = getRoot()
    if root then
        local arrival = plotCFrame + Vector3.new(0, 3, 0)
        root.CFrame = arrival
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.Anchored = false

        if directTeleport then
            task.wait(Farm.Config.TeleportConfirmDelay)
            root = getRoot()
            if root and (root.Position - arrival.Position).Magnitude > Farm.Config.TeleportCorrectionRadius then
                Farm.TeleportRejectedUntil = os.clock() + Farm.Config.TeleportRetryDelay
                setFarmStatus("Plot teleport corrected; using smooth movement temporarily")
                if Farm.Enabled then
                    moveToPosition(plotCFrame.Position, nil)
                end
            end
        end
    end

    clearPlatform()
    return true
end


--======================================================================--
--  RIDE A PET RANCH AUTOMATION
--  The dump shows the game exposes:
--    * Workspace.Plots.<plot>.Nests.*.PlacePromptAnchor.Place
--    * ready eggs with an enabled "Hatch" ProximityPrompt
--    * PlayerGui.Main.PetsTracker.PlaceBest
--  We intentionally use the game's own prompts/button handlers instead of
--  guessing private RemoteEvent argument layouts.
--======================================================================--

local function isEggTool(tool)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    if tool:GetAttribute("EggInventoryId") ~= nil then
        return true
    end

    return string.find(string.lower(tool.Name), "egg", 1, true) ~= nil
end

local function eggToolScore(tool)
    if not tool then
        return 0
    end

    local canonical = normalizeEggName(tool.Name)
    local value = getEggValue(canonical)

    return tonumber(value) or 0
end

local function getEggTools()
    local found = {}
    local seen = {}

    local function scan(container)
        if not container then
            return
        end

        for _, child in ipairs(container:GetChildren()) do
            if isEggTool(child) and not seen[child] then
                seen[child] = true
                table.insert(found, child)
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("Backpack"))
    scan(getCharacter())

    table.sort(found, function(a, b)
        local av = eggToolScore(a)
        local bv = eggToolScore(b)

        if av == bv then
            return a.Name < b.Name
        end
        return av > bv
    end)

    return found
end

local function getPlacePrompts(plot)
    local prompts = {}
    local nests = plot and plot:FindFirstChild("Nests")
    if not nests then
        return prompts
    end

    for _, descendant in ipairs(nests:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            local action = string.lower(tostring(descendant.ActionText or ""))
            if descendant.Name == "Place" or action == "place" then
                table.insert(prompts, descendant)
            end
        end
    end

    table.sort(prompts, function(a, b)
        return a:GetFullName() < b:GetFullName()
    end)

    return prompts
end

local function getPromptPart(prompt)
    local current = prompt and prompt.Parent
    while current and current ~= Workspace do
        if current:IsA("BasePart") then
            return current
        end
        current = current.Parent
    end
    return nil
end

local function triggerPrompt(prompt, forceNear)
    if not prompt or not prompt.Parent then
        return false
    end

    local root = getRoot()
    local part = getPromptPart(prompt)
    local oldCFrame = root and root.CFrame
    local oldAnchored = root and root.Anchored

    -- Ride a Pet updates/enables several prompts only when the character is
    -- actually close to the target. Move near it before firing.
    if forceNear and root and part then
        pcall(function()
            root.Anchored = false
            root.CFrame = part.CFrame * CFrame.new(0, 3.2, 2.2)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        task.wait(0.2)
    end

    local fired = false

    if type(fireproximityprompt) == "function" then
        fired = pcall(function()
            fireproximityprompt(prompt)
        end)
    end

    if not fired and root and part then
        fired = pcall(function()
            prompt:InputHoldBegin()
            task.wait(math.max(prompt.HoldDuration, 0.08))
            prompt:InputHoldEnd()
        end)
    end

    task.wait(0.12)

    if forceNear and root and oldCFrame then
        pcall(function()
            root.CFrame = oldCFrame
            root.Anchored = oldAnchored or false
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    return fired
end

local function equipEggTool(tool)
    if not tool or not tool.Parent then
        return false
    end

    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then
        return false
    end

    if tool.Parent == character then
        return true
    end

    local ok = pcall(function()
        humanoid:EquipTool(tool)
    end)

    if ok then
        task.wait(0.15)
    end

    return ok and tool.Parent == character
end

local function unequipTools()
    local character = getCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        pcall(function()
            humanoid:UnequipTools()
        end)
    end
end

local function getRideGameRemotes()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local gameRemotes = remotes and remotes:FindFirstChild("Game")
    return gameRemotes
end

local function isDescendantOfFolderNamed(inst, names)
    local current = inst
    while current do
        if names[current.Name] then
            return true
        end
        current = current.Parent
    end
    return false
end

local function getPlotGroundPart(plot)
    if not plot then
        return nil
    end

    local excludedFolders = {
        Eggs = true,
        Pets = true,
        Fence = true,
        Nests = true,
        HatchUpgrade = true,
    }

    local bestPart = nil
    local bestScore = -1

    for _, part in ipairs(plot:GetDescendants()) do
        if part:IsA("BasePart")
            and not isDescendantOfFolderNamed(part, excludedFolders)
            and part.Size.X >= 8
            and part.Size.Z >= 8
            and part.Size.Y <= 12 then

            local area = part.Size.X * part.Size.Z

            -- Prefer broad, flat ranch/floor pieces.
            local flatBonus = math.max(0, 8 - part.Size.Y) * 50
            local score = area + flatBonus

            if score > bestScore then
                bestScore = score
                bestPart = part
            end
        end
    end

    -- Fallback: any large horizontal plot part.
    if not bestPart then
        for _, part in ipairs(plot:GetDescendants()) do
            if part:IsA("BasePart") and part.Size.X >= 8 and part.Size.Z >= 8 then
                local score = part.Size.X * part.Size.Z
                if score > bestScore then
                    bestScore = score
                    bestPart = part
                end
            end
        end
    end

    return bestPart
end

local function getEggWorldPosition(egg)
    if not egg then
        return nil
    end

    local base = egg:FindFirstChild("EggBase", true)
    if base and base:IsA("BasePart") then
        return base.Position
    end

    local handle = egg:FindFirstChild("Handle", true)
    if handle and handle:IsA("BasePart") then
        return handle.Position
    end

    if egg:IsA("Model") then
        local ok, pivot = pcall(function()
            return egg:GetPivot()
        end)
        if ok then
            return pivot.Position
        end
    elseif egg:IsA("BasePart") then
        return egg.Position
    end

    local part = egg:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function getPetWorldPosition(pet)
    if not pet then
        return nil
    end

    local root = pet:FindFirstChild("RootPart", true)
    if root and root:IsA("BasePart") then
        return root.Position
    end

    if pet:IsA("Model") then
        local ok, pivot = pcall(function()
            return pet:GetPivot()
        end)
        if ok then
            return pivot.Position
        end
    end

    local part = pet:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function horizontalDistance(a, b)
    return (
        Vector3.new(a.X, 0, a.Z)
        - Vector3.new(b.X, 0, b.Z)
    ).Magnitude
end

local function getExistingEggPositions(plot)
    local result = {}
    local eggsFolder = plot and plot:FindFirstChild("Eggs")

    if eggsFolder then
        for _, egg in ipairs(eggsFolder:GetChildren()) do
            local pos = getEggWorldPosition(egg)
            if pos then
                table.insert(result, pos)
            end
        end
    end

    return result
end

local function getExistingPetPositions(plot)
    local result = {}
    local petsFolder = plot and plot:FindFirstChild("Pets")

    if petsFolder then
        for _, pet in ipairs(petsFolder:GetChildren()) do
            local pos = getPetWorldPosition(pet)
            if pos then
                table.insert(result, pos)
            end
        end
    end

    return result
end

local function getCandidatePlantPositions(plot)
    local candidates = {}
    local existingEggs = getExistingEggPositions(plot)
    local petPositions = getExistingPetPositions(plot)
    local ground = getPlotGroundPart(plot)

    -- First preference: build a small grid around the eggs that are already
    -- accepted by the server on this ranch. This keeps placement inside the
    -- same valid growing zone.
    if #existingEggs > 0 then
        local sum = Vector3.zero
        for _, pos in ipairs(existingEggs) do
            sum += pos
        end

        local center = sum / #existingEggs
        local spacing = 5.5

        for radius = 0, 4 do
            for gx = -radius, radius do
                for gz = -radius, radius do
                    if radius == 0 or math.abs(gx) == radius or math.abs(gz) == radius then
                        local candidate = Vector3.new(
                            center.X + gx * spacing,
                            center.Y,
                            center.Z + gz * spacing
                        )

                        local clear = true

                        for _, pos in ipairs(existingEggs) do
                            if horizontalDistance(candidate, pos) < 4.4 then
                                clear = false
                                break
                            end
                        end

                        if clear then
                            for _, pos in ipairs(petPositions) do
                                if horizontalDistance(candidate, pos) < 5 then
                                    clear = false
                                    break
                                end
                            end
                        end

                        if clear then
                            table.insert(candidates, candidate)
                        end
                    end
                end
            end
        end
    end

    -- Second preference / empty ranch fallback: use the largest flat part of
    -- the player's plot and generate points on its top surface.
    if ground then
        local sx = math.max(4, math.min(ground.Size.X * 0.32, 18))
        local sz = math.max(4, math.min(ground.Size.Z * 0.32, 18))
        local topY = ground.Size.Y / 2 + 0.08

        local localPoints = {
            Vector3.new(0, topY, 0),
            Vector3.new( sx * 0.45, topY, 0),
            Vector3.new(-sx * 0.45, topY, 0),
            Vector3.new(0, topY,  sz * 0.45),
            Vector3.new(0, topY, -sz * 0.45),
            Vector3.new( sx * 0.45, topY,  sz * 0.45),
            Vector3.new(-sx * 0.45, topY,  sz * 0.45),
            Vector3.new( sx * 0.45, topY, -sz * 0.45),
            Vector3.new(-sx * 0.45, topY, -sz * 0.45),
        }

        for _, localPoint in ipairs(localPoints) do
            local world = ground.CFrame:PointToWorldSpace(localPoint)

            local clear = true
            for _, pos in ipairs(existingEggs) do
                if horizontalDistance(world, pos) < 4.4 then
                    clear = false
                    break
                end
            end

            if clear then
                for _, pos in ipairs(petPositions) do
                    if horizontalDistance(world, pos) < 5 then
                        clear = false
                        break
                    end
                end
            end

            if clear then
                table.insert(candidates, world)
            end
        end
    end

    -- Last fallback: current player position. The server still validates the
    -- point, so this only works if the player is standing on their ranch.
    local root = getRoot()
    if root then
        table.insert(candidates, Vector3.new(root.Position.X, root.Position.Y - 3, root.Position.Z))
    end

    return candidates
end

local function getToolAmount(tool)
    if not tool then
        return nil
    end

    local data = tool:FindFirstChild("Data")
    local amount = data and data:FindFirstChild("Amount")

    if amount and amount:IsA("ValueBase") then
        return tonumber(amount.Value)
    end

    return nil
end

local function eggWasConsumed(tool, inventoryId, beforeAmount)
    if not tool or not tool.Parent then
        return true
    end

    local afterAmount = getToolAmount(tool)
    if beforeAmount and afterAmount and afterAmount < beforeAmount then
        return true
    end

    if inventoryId ~= nil then
        local foundSameId = false

        for _, candidate in ipairs(getEggTools()) do
            if candidate:GetAttribute("EggInventoryId") == inventoryId then
                foundSameId = true
                break
            end
        end

        if not foundSameId then
            return true
        end
    end

    return false
end

local function getPlotEggCount(plot)
    plot = plot or getOwnedPlot()
    local eggs = plot and plot:FindFirstChild("Eggs")
    return eggs and #eggs:GetChildren() or 0
end

local function eggModelIsReady(egg)
    if not egg then
        return false
    end

    -- World UI / prompt state.
    for _, descendant in ipairs(egg:GetDescendants()) do
        if descendant:IsA("TextLabel") then
            local textValue = string.lower(tostring(descendant.Text or ""))
            if textValue == "ready" then
                return true
            end
        elseif descendant:IsA("ProximityPrompt") then
            local action = string.lower(tostring(descendant.ActionText or ""))
            if (descendant.Name == "Hatch" or action == "hatch") and descendant.Enabled then
                return true
            end
        end
    end

    return false
end

local function getReadyEggModels(plot)
    local ready = {}
    plot = plot or getOwnedPlot()

    local eggs = plot and plot:FindFirstChild("Eggs")
    if not eggs then
        return ready
    end

    for _, egg in ipairs(eggs:GetChildren()) do
        local key = egg:GetAttribute("EggKey")
        if key and eggModelIsReady(egg) then
            table.insert(ready, egg)
        end
    end

    return ready
end

local function hatchEggModelDirect(egg)
    if not egg or not egg.Parent then
        return false, "Egg no longer exists"
    end

    local eggKey = egg:GetAttribute("EggKey")
    if not eggKey then
        return false, "EggKey missing"
    end

    local gameRemotes = getRideGameRemotes()
    local hatch = gameRemotes and gameRemotes:FindFirstChild("Hatch")

    if not hatch or not hatch:IsA("RemoteEvent") then
        return false, "Hatch remote not found"
    end

    local plot = getOwnedPlot()
    local beforeCount = getPlotEggCount(plot)

    pcall(function()
        hatch:FireServer({
            EggKey = tostring(eggKey)
        })
    end)

    local deadline = os.clock() + 2.5
    while os.clock() < deadline do
        if not egg.Parent or getPlotEggCount(plot) < beforeCount then
            return true, "Hatched " .. tostring(egg.Name)
        end
        task.wait(0.06)
    end

    return false, "Hatch was sent but egg stayed on plot"
end

local function placeOneEgg()
    local gameRemotes = getRideGameRemotes()
    local eggPlaced = gameRemotes and gameRemotes:FindFirstChild("EggPlaced")

    if not eggPlaced or not eggPlaced:IsA("RemoteEvent") then
        return false, "EggPlaced remote not found"
    end

    local plot = getOwnedPlot()
    if not plot then
        return false, "Your plot was not found"
    end

    local currentEggCount = getPlotEggCount(plot)
    if currentEggCount >= Farm.Config.MaxPlotEggs then
        return false, string.format(
            "Plot full: %d/%d - waiting for an egg to mature",
            currentEggCount,
            Farm.Config.MaxPlotEggs
        )
    end

    local tools = getEggTools()
    if #tools == 0 then
        return false, "No eggs in backpack"
    end

    -- Only one egg per pass.
    local tool = tools[1]
    local toolName = tool.Name
    local inventoryId = tool:GetAttribute("EggInventoryId")
    local beforeAmount = getToolAmount(tool)

    local eggsFolder = plot:FindFirstChild("Eggs")
    local beforeCount = eggsFolder and #eggsFolder:GetChildren() or 0

    if not equipEggTool(tool) then
        return false, "Could not equip " .. toolName
    end

    task.wait(0.22)

    local candidates = getCandidatePlantPositions(plot)
    if #candidates == 0 then
        unequipTools()
        return false, "Could not find a valid ranch placement point"
    end

    -- SAFE recorder showed manual placement is exactly:
    -- EggPlaced:FireServer({ PlantPosition = Vector3 })
    -- No RequestPlotEggs call is required for the plant action itself.
    for index, position in ipairs(candidates) do
        if not Farm.AutoPlaceEnabled and Farm.Alive then
            break
        end

        pcall(function()
            eggPlaced:FireServer({
                PlantPosition = position
            })
        end)

        local deadline = os.clock() + 0.8
        while os.clock() < deadline do
            local afterCount = eggsFolder and #eggsFolder:GetChildren() or beforeCount

            if eggWasConsumed(tool, inventoryId, beforeAmount) or afterCount > beforeCount then
                unequipTools()
                return true, string.format("Placed %s (point %d)", toolName, index)
            end

            task.wait(0.05)
        end
    end

    unequipTools()
    return false, "Server rejected all generated ranch positions"
end

local function getReadyHatchPrompts()
    local result = {}
    local plot = getOwnedPlot()
    local eggs = plot and plot:FindFirstChild("Eggs")
    if not eggs then
